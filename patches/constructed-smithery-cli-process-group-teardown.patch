+// Constructed fix, mirroring mcp/os/posix/utilities.py's
+// terminate_posix_process_tree: signal the whole process group (the
+// negative pid), not only the direct child, since createStdioLocalPeer now
+// spawns with detached: true so the child leads its own group. Polls with
+// signal 0 the same way the Python side does, since a group only
+// disappears once every member is dead and reaped.
+async function killProcessGroup(
+	child: ReturnType<typeof spawn>,
+	signal: NodeJS.Signals,
+): Promise<void> {
+	const pid = child.pid
+	if (pid === undefined || process.platform === "win32") {
+		child.kill(signal)
+		return
+	}
+	try {
+		process.kill(-pid, signal)
+	} catch {
+		// Group already gone.
+		return
+	}
+	const deadline = Date.now() + STDIO_KILL_TIMEOUT_MS
+	while (Date.now() < deadline) {
+		try {
+			process.kill(-pid, 0)
+		} catch {
+			return
+		}
+		await delay(10)
+	}
+}
